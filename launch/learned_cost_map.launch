        </node>

        <node pkg="physics_atv_deep_stereo_vo" type="tartanvo_node.py" name="tartanvo_node" output="screen" >
        </node>

        <node pkg="physics_atv_local_mapping" type="local_mapping_node" name="localmapping_node" output="screen" >
