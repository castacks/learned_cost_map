            <param name ="/downsample_leafsize_before" value="0.1"/>
            <param name ="/downsample_pointcloud_after" value="false"/>
            <param name ="/downsample_leafsize_after" value="0.02"/>
            <param name ="/resolution" value="0.02"/>
